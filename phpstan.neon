#includes:
    # https://github.com/spaze/phpstan-disallowed-calls
    #- vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
# https://arnaud.le-blanc.net/post/phpstan-generics.html
# https://phpstan.org/blog/generics-in-php-using-phpdocs
parameters:
    level: max
    paths:
        - config
        - tests
        - public
        - src
    excludePaths:
        - config/reference.php (?) # generated by Symfony
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    #bootstrapFiles:
        #- %rootDir%/../../../vendor/twig/twig/src/Extension/CoreExtension.php

    # https://phpstan.org/user-guide/ignoring-errors#reporting-unused-ignores
    # reportUnmatchedIgnoredErrors: true
    banned_code:
        non_ignorable: false # allow inline @phpstan-ignore for legit uses (e.g. testing dump())

    ignoreErrors:
        # - '#foobar_pattern#'
        # src/Test holds test helpers shipped in src/
        -
            identifier: ekinoBannedCode.test
            path: src/Test/*
        # Pre-existing entity/mapping nullability mismatches, fixing them requires a migration
        -
            identifier: doctrine.columnType
            paths:
                - src/Entity/Address.php
                - src/Entity/User.php
        -
            identifier: doctrine.associationType
            paths:
                - src/Entity/GroupOffer.php
                - src/Entity/MenuItem.php
